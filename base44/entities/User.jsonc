{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "enum": [
        "customer",
        "business_owner"
      ],
      "description": "Whether this user is a shopper or a storage partner"
    },
    "business_id": {
      "type": "string",
      "description": "The Business record this partner operates (business_owner only)"
    },
    "phone": {
      "type": "string"
    }
  },
  "required": [
    "role"
  ]
}