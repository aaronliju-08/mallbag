{
  "name": "Business",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "shop_number": {
      "type": "string"
    },
    "floor": {
      "type": "string",
      "enum": [
        "Ground",
        "First",
        "Second",
        "Third"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Electronics",
        "Fashion",
        "Books",
        "Food",
        "Cinema",
        "Entertainment",
        "Sports",
        "Concierge",
        "Other"
      ]
    },
    "price_per_bag": {
      "type": "number"
    },
    "is_free": {
      "type": "boolean",
      "default": false
    },
    "capacity": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "mall_name": {
      "type": "string",
      "default": "Aurora Mall"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "shop_number",
    "floor",
    "capacity"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}